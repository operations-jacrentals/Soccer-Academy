# --- Secrets & local env ---------------------------------------------------
# Real env files are never committed; only *.env.example is tracked.
.env
.env.*
!.env.example
*.env
!*.env.example
config/environments/*.env
!config/environments/*.env.example

# --- Node ------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
!/apps/family-calendar/build/
!/apps/family-calendar/build/**
.next/
.turbo/
coverage/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- MkDocs ----------------------------------------------------------------
# Built site output (published to the gh-pages branch by CI, never committed).
/site/

# --- Editors / OS ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
