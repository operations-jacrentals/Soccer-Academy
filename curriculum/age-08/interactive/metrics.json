    {"id": "D3",  "week": "A", "dow": "Wed", "title": "1v1 & the body feint",             "objective": "1v1 Moves",                "metric": "brave1",      "entry": "heart"},
    {"id": "D4",  "week": "A", "dow": "Thu", "title": "First touch",                      "objective": "Receiving",                "metric": "cushion",     "entry": "pr"},
    {"id": "D5",  "week": "A", "dow": "Fri", "title": "Creativity, play & checkpoint",    "objective": "Ball Mastery · creativity","metric": "mymove",      "entry": "heart"},
    {"id": "D6",  "week": "B", "dow": "Mon", "title": "Inside-foot passing",              "objective": "Receiving & Passing",      "metric": "pass",        "entry": "pr"},
    {"id": "D7",  "week": "B", "dow": "Tue", "title": "Give-and-go (1-2)",                "objective": "Receiving & Passing",      "metric": "onetwo",      "entry": "pr"},
    {"id": "D8",  "week": "B", "dow": "Wed", "title": "Step-over & drag-back",            "objective": "1v1 Moves",                "metric": "brave2",      "entry": "heart"},
