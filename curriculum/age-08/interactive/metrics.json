    {"id": "D10", "week": "B", "dow": "Fri", "title": "Finishing & combine + checkpoint", "objective": "Finishing -> Group",       "metric": "finish",      "entry": "pr"},
    {"id": "D11", "week": "C", "dow": "Mon", "title": "Small-sided & find space",         "objective": "Group Play",               "metric": "teamstreak",  "entry": "pr"},
